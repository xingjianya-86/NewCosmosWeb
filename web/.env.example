# 业务 API 根地址（.2）
# 生产构建默认即为该值；本地联调请留空，走 /api 的 Vite 代理。
VITE_API_BASE=https://cosmos-static.sua17.cn:20000

# 认证 API 根地址；留空表示同源（https://cosmos.sua17.cn/api/auth）。
VITE_AUTH_BASE=

# 静态资源根地址；生产为 .2 的 100Mbps 静态站点，必须使用绝对地址。
# 本地开发留空，使用 Vite 自带 /assets。
VITE_ASSET_BASE=https://cosmos-static.sua17.cn:20000/

# Vue Router history base：页面在 .1 根路径；不要和 VITE_ASSET_BASE 混用。
VITE_ROUTER_BASE=/
