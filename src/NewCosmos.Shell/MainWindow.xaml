<Window x:Class="NewCosmos.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="帝皇权杖δ-me13 社会救助管理系统"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F2ECE1">
    <Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
        <Border x:Name="LoadingPanel" Background="#F2ECE1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="帝皇权杖δ-me13" FontSize="30" FontWeight="SemiBold"
                           Foreground="#171310" HorizontalAlignment="Center" />
                <TextBlock Text="社会救助管理系统" FontSize="16" Foreground="#4C4237"
                           Margin="0,8,0,0" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                             Margin="0,28,0,0" Foreground="#AB3227" />
                <TextBlock x:Name="LoadingText" Text="正在加载…" FontSize="13"
                           Foreground="#6B7280" Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border x:Name="ErrorPanel" Background="#F5F6F8" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <TextBlock Text="无法连接服务" FontSize="24" FontWeight="SemiBold"
                           Foreground="#B91C1C" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Text="" FontSize="14" Foreground="#4B5563"
                           Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="重试" Width="96" Height="36" Margin="0,0,12,0"
                            Click="Retry_Click" />
                    <Button Content="打开浏览器" Width="120" Height="36"
                            Click="OpenBrowser_Click" />
                </StackPanel>
                <TextBlock x:Name="ServerText" FontSize="12" Foreground="#9CA3AF"
                           Margin="0,18,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
