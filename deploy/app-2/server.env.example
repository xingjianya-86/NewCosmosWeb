# NewCosmos.Server runtime environment
# 1) cp server.env.example server.env
# 2) chmod 600 server.env
# 3) fill real values, never commit server.env
# All values below are placeholders.

# ---- PostgreSQL ------------------------------------------------------------
# Docker: host PostgreSQL is reachable via host.docker.internal (compose adds host-gateway).
# systemd: use 127.0.0.1. You can also use 10.110.0.2 consistently.
NC_DB_HOST=host.docker.internal
NC_DB_PORT=5432
NC_DB_NAME=newcosmos
NC_DB_USER=newcosmos_app
NC_DB_PASS=__REPLACE_WITH_STRONG_DB_PASSWORD__
# Backward-compatible alias if your deploy tooling uses this name:
# NC_DB_PASSWORD=__REPLACE_WITH_STRONG_DB_PASSWORD__

# ---- Web / CORS ------------------------------------------------------------
# Only the page origin. Business API does not use cross-site cookies.
NC_CORS_ORIGIN=https://cosmos.sua17.cn

# ---- Agent registration ----------------------------------------------------
# One-time registration token; generate with: openssl rand -hex 32
# Only shipped in the Windows Agent installer, never exposed to the browser.
NC_AGENT_REGISTER_TOKEN=__REPLACE_WITH_32_BYTE_RANDOM_HEX__

# ---- Database migration ----------------------------------------------------
# Set true for first deploy, then switch back to false.
NC_AUTO_MIGRATE=false

# ---- Request limits --------------------------------------------------------
# 128 MB is required for photo/import uploads. P0 auth-only traffic is much smaller.
NC_MAX_BODY_MB=128

# ---- Runtime ---------------------------------------------------------------
TZ=Asia/Shanghai
ASPNETCORE_ENVIRONMENT=Production
# Docker image and systemd set the listen address; do not hard-code it here.
# ASPNETCORE_URLS=http://0.0.0.0:8787
