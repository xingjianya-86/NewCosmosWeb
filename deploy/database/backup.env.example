# =============================================================================
# PostgreSQL 备份环境变量示例
# -----------------------------------------------------------------------------
# 安装：
#   sudo install -d -m 0755 /etc/newcosmos
#   sudo install -m 0600 deploy/database/backup.env.example /etc/newcosmos/backup.env
#   sudo vi /etc/newcosmos/backup.env
#
# 所有值均为占位符；不要把真实密码提交到 Git。
# =============================================================================

# 备份脚本在宿主机运行，连本机 PostgreSQL。
# 如果 PG 只监听 Unix socket，可把 HOST 改成 /var/run/postgresql。
NC_DB_HOST=127.0.0.1
NC_DB_PORT=5432
NC_DB_NAME=newcosmos
NC_DB_USER=newcosmos_backup
NC_DB_PASSWORD=__REPLACE_WITH_STRONG_DB_PASSWORD__

# 备份目录必须在 Web 根之外（脚本会拒绝 /srv/newcosmos/web 下的路径）。
NC_BACKUP_DIR=/srv/newcosmos/backups/postgres
NC_BACKUP_RETENTION_DAYS=14

# 可选：sslmode=disable 仅限本机回环；跨机请用 require/verify-full。
# NC_DB_SSLMODE=disable
