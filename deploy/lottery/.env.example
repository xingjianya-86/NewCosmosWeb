# 复制为 .env 后填写；本文件不含真实凭据，.env 已被 .gitignore 排除。
# PostgreSQL（.2 宿主机或同一 Docker 网络中的服务）
NC_DB_HOST=host.docker.internal
NC_DB_PORT=5432
NC_DB_NAME=new_cosmos
NC_DB_USER=new_cosmos
NC_DB_PASSWORD=change-me

# 资源与队列（可保持默认）
NC_LOTTERY_MAX_MEMORY_MB=1536
NC_LOTTERY_DEFAULT_WINDOW=73
NC_LOTTERY_MAX_PENDING=32
NC_LOTTERY_TRAIN_TIMEOUT_SEC=21600
NC_LOTTERY_PREDICT_TIMEOUT_SEC=1800
