<Project>
  <PropertyGroup>
    <!-- 全栈统一版本：.NET 项目唯一来源；Web 侧见 web/package.json -->
    <Version>2.0.20261124</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.20261124</InformationalVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1416;CA1707;CA1859;CA1845;CA1822;CA1852;CA2201;CA1000;CA1001;CA1716;CA1816;CS8625</NoWarn>
  </PropertyGroup>
</Project>
