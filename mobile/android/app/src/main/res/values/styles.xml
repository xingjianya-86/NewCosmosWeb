<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 应用主题：浅色，状态栏/导航栏随页面保持深色图标。 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/nc_window_bg</item>
        <item name="android:statusBarColor">@color/nc_window_bg</item>
        <item name="android:navigationBarColor">@color/nc_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/nc_window_bg</item>
        <item name="android:statusBarColor">@color/nc_window_bg</item>
        <item name="android:navigationBarColor">@color/nc_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/nc_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/nc_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/nc_splash_bg</item>
        <item name="android:navigationBarColor">@color/nc_splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
