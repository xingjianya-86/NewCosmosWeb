<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 生产：禁止明文 HTTP，仅信任系统 CA。开发构建由 src/debug 覆盖为允许明文。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
